#!/bin/sh
# The Zig that ghostty-vt-sys builds libghostty-vt with. mise installs it on first use.
#
# ghostty-vt-sys copies Ghostty's source to $OUT_DIR/src and runs
# `zig build ... --cache-dir $OUT_DIR/zig-cache` there. Zig keys its cache on the absolute path
# of every source file the build reads, so each target directory or profile compiled Ghostty from
# nothing, even with the cache directory shared. This wrapper therefore (1) replaces the
# `--cache-dir` value with a cache shared by every checkout on the machine, and (2) runs the build
# from a copy of the source at a path named by the source's content hash, the same for every
# target directory. Zig's cache is content-addressed and locks its entries, so builds from
# several worktrees can use it at once. Every other argument, `--prefix` included, passes through
# unchanged, and a call that is not `zig build` with a `build.zig` in the directory (`zig version`)
# runs as given.
root="${XDG_CACHE_HOME:-$HOME/.cache}/wheel"
cache="$root/ghostty-zig"
n=$#
skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then
    set -- "$@" "$cache"
    skip=0
  elif [ "$a" = "--cache-dir" ]; then
    set -- "$@" "$a"
    skip=1
  else
    set -- "$@" "$a"
  fi
done
shift "$n"

if [ "$1" = build ] && [ -f build.zig ]; then
  key=$(find . -type f -not -path './zig-pkg/*' -not -path './.zig-cache/*' -not -path './zig-out/*' |
    LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | cut -c1-16)
  stable="$root/ghostty-src/$key"
  if [ ! -d "$stable" ]; then
    mkdir -p "$root/ghostty-src"
    tmp="$stable.$$"
    cp -R . "$tmp" && mv "$tmp" "$stable" 2>/dev/null
    rm -rf "$tmp"
  fi
  cd "$stable" || exit 1
fi
exec mise exec zig@0.16.0 -- zig "$@"
