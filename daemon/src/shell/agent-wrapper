#!/bin/sh
# Starts the real @NAME@ with Wheel's brief added to its instructions when run inside a Wheel pane.
# A PATH can list the bin directories of several Wheel instances; the real program is the first
# @NAME@ that is not a wrapper like this one, found by the line below.
# wheel-agent-wrapper
self_dir=$(cd "$(dirname "$0")" && pwd)
real=
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$self_dir" ] && continue
  [ -x "$dir/@NAME@" ] && [ ! -d "$dir/@NAME@" ] || continue
  grep -q '^# wheel-agent-wrapper$' "$dir/@NAME@" 2>/dev/null && continue
  real="$dir/@NAME@"; break
done
IFS=$old_ifs
if [ -z "$real" ]; then
  echo "@NAME@: not found on PATH" >&2
  exit 127
fi
if [ -n "$WHEEL_ENV" ] && [ -z "$WHEEL_AGENT_PANE" ] && [ -z "${@HOME_VAR@:-}" ] && [ -x "$self_dir/wheel" ]; then
  wheel_home=$("$self_dir/wheel" config get agent.@NAME@.home 2>/dev/null)
  if [ -n "$wheel_home" ]; then @HOME_VAR@=$wheel_home; export @HOME_VAR@; fi
fi
if [ -n "$WHEEL_ENV" ] && [ -r "$WHEEL_BRIEF_FILE" ]; then
  case "$1" in
    @SKIP@) ;;
    *) @EXEC@ ;;
  esac
fi
exec "$real" "$@"
