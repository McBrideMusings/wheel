# Wheel's bash startup: what a login bash reads, then Wheel's bin directory on PATH.
[ -r /etc/profile ] && . /etc/profile
for f in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
  if [ -r "$f" ]; then . "$f"; break; fi
done
# Values picked for this pane (`wheel pane reload --env`) win over the person's startup files.
for WHEEL_NAME in $WHEEL_PICKED; do
  WHEEL_VALUE="WHEEL_PICKED_$WHEEL_NAME"
  export "$WHEEL_NAME=${!WHEEL_VALUE}"
  unset "$WHEEL_VALUE"
done
unset WHEEL_PICKED WHEEL_NAME WHEEL_VALUE
case ":$PATH:" in
  ":$WHEEL_BIN:"*) ;;
  *) PATH="$WHEEL_BIN:$PATH" ;;
esac
export PATH
