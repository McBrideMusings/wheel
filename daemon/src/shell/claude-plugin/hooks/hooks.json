{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "wheel pane report-conversation >/dev/null 2>&1 || true" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "wheel pane report working >/dev/null 2>&1 || true" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "wheel pane report needs_you --hook-input >/dev/null 2>&1 || true" }] }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog",
        "hooks": [{ "type": "command", "command": "wheel pane report needs_you --hook-input >/dev/null 2>&1 || true" }]
      }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "wheel pane report working >/dev/null 2>&1 || true" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "wheel pane report idle >/dev/null 2>&1 || true" }] }
    ]
  }
}
